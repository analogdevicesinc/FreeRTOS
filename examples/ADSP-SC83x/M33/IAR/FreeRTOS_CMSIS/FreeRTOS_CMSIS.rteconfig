<?xml version="1.0" encoding="UTF-8" standalone="no"?>

<configuration xmlns:xs="http://www.w3.org/2001/XMLSchema-instance">

  <packages/>

  <device Dclock="400000000" Dcore="Cortex-M33" DcoreVersion="r1p0" Ddsp="DSP" Dendian="Little-endian" Dfamily="ADSP-SC83x Series" Dfpu="SP_FPU" Dmpu="MPU" Dname="ADSP-SC839W" Dsecure="Non-secure" Dtz="TZ" Dvendor="Analog Devices:1" info="ARM , 1575744 KB RAM, 256 KB ROM" url="http://www.keil.com/dd2/analogdevices/adsp_sc839w">

    <package info="Analog Devices ADSP-SC83x Cortex-M33 Core Support.&#10;    (Subject to the Software License Agreement referred to in the Release Notes.)" name="ADSP-SC83x_DFP" url="http://download.analog.com/tools/EZBoards/ADSP-SC83x/Releases/" vendor="AnalogDevices" version="1.9.7"/>

  </device>

  <toolchain Tcompiler="IAR" Toutput="exe"/>

  <components>

    <component Cclass="CMSIS" Cgroup="CORE" Cvendor="ARM" Cversion="5.6.0">

