    </component>

    <component Cbundle="FreeRTOS" Cbundleversion="10.5.1" Cclass="RTOS" Cgroup="Config" Cvariant="CMSIS RTOS2" Cvendor="ARM" Cversion="10.5.1">

      <package name="CMSIS-FreeRTOS" url="https://www.keil.com/pack/" vendor="ARM" version="10.5.1"/>

      <file category="doc" name="CMSIS/Documentation/General/html/cre_freertos_proj.html#cmsis_freertos_config"/>

      <file attr="config" category="header" condition="CoreM" name="CMSIS/RTOS2/FreeRTOS/Config/ARMCM/FreeRTOSConfig.h" version="10.4.0"/>

    </component>

    <component Cbundle="FreeRTOS" Cbundleversion="10.5.1" Cclass="RTOS" Cgroup="Core" Cvariant="Cortex-M" Cvendor="ARM" Cversion="10.5.1">

