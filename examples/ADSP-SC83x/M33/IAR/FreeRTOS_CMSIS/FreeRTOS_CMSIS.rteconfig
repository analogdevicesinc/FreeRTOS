      <file attr="config" category="source" deviceDependent="1" name="Source/startup_ADSP-SC83x.c" version="1.0.0"/>

      <file attr="config" category="header" deviceDependent="1" name="Include/system_ADSP-SC83x.h" version="1.0.0"/>

      <file attr="config" category="source" deviceDependent="1" name="Source/system_ADSP-SC83x.c" version="1.0.0"/>

