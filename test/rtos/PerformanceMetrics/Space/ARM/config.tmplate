PROCESSOR = PROCESSOR_TEMPLATE 


START:
     # Build the basic projects
     <CMD, python ../CCESSpace.py  -d FreeRTOS_MIN_NOP_Core0 -o 1>
     <BUILDPROJECT, FreeRTOS_MIN_NOP_Core0, Release>
      # I don't trust the headless builder to finish correctly before this process continues.
     <SLEEP, 3>
     <ASSERT_FILEEXISTS, FreeRTOS_MIN_NOP_Core0/Release/FreeRTOS_MIN_NOP_Core0>
     <CMD, python ../CCESSpace.py -d FreeRTOS_MIN_NOP_Core0 -p PROCESSOR_TEMPLATE -a -t NONE>


     # Messages
     <CMD, python ../CCESSpace.py  -d FreeRTOS_MIN_MSG_Core0 -o 1>
     <BUILDPROJECT, FreeRTOS_MIN_MSG_Core0, Release>
