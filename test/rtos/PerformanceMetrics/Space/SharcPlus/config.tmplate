PROCESSOR = PROCESSOR_TEMPLATE


START:
     # Build the basic projects
     <CMD, python ../CCESSpace.py  -d FreeRTOS_MIN_NOP_Core1 -o 1>
     <BUILDPROJECT, FreeRTOS_MIN_NOP_Core1, Release>
      # I don't trust the headless builder to finish correctly before this process continues.
     <SLEEP, 3>
     <ASSERT_FILEEXISTS, FreeRTOS_MIN_NOP_Core1/Release/FreeRTOS_MIN_NOP_Core1.dxe>
     <CMD, python ../CCESSpace.py -d FreeRTOS_MIN_NOP_Core1 -p PROCESSOR_TEMPLATE -t NONE>


     # Messages
     <CMD, python ../CCESSpace.py  -d FreeRTOS_MIN_MSG_Core1 -o 1>
     <BUILDPROJECT, FreeRTOS_MIN_MSG_Core1, Release>
      # I don't trust the headless builder to finish correctly before this process continues.
     <SLEEP, 3>
     <ASSERT_FILEEXISTS, FreeRTOS_MIN_MSG_Core1/Release/FreeRTOS_MIN_MSG_Core1.dxe>
     <CMD, python ../CCESSpace.py -d FreeRTOS_MIN_MSG_Core1 -p PROCESSOR_TEMPLATE -t MSG -n 1>
     <CMD, python ../CCESSpace.py  -d FreeRTOS_MIN_MSG_Core1 -o 2>
     <BUILDPROJECT, FreeRTOS_MIN_MSG_Core1, Release>
      # I don't trust the headless builder to finish correctly before this process continues.
