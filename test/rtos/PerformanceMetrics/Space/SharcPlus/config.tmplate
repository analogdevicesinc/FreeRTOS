     <CMD, python ../CCESSpace.py  -d FreeRTOS_MIN_MUT_Core1 -o 2>
     <BUILDPROJECT, FreeRTOS_MIN_MUT_Core1, Release>
      # I don't trust the headless builder to finish correctly before this process continues.
