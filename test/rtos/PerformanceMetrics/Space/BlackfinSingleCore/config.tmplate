PROCESSOR = PROCESSOR_TEMPLATE 


START:
     # Build the basic projects
     <CMD, python ../CCESSpace.py  -d FreeRTOS_MIN_NOP -o 1>
     <BUILDPROJECT, FreeRTOS_MIN_NOP, Release>
      # I don't trust the headless builder to finish correctly before this process continues.
     <SLEEP, 3>
     <ASSERT_FILEEXISTS, FreeRTOS_MIN_NOP/Release/FreeRTOS_MIN_NOP.dxe>
     <CMD, python ../CCESSpace.py -d FreeRTOS_MIN_NOP -p PROCESSOR_TEMPLATE  -t NONE>


     # Messages
     <CMD, python ../CCESSpace.py  -d FreeRTOS_MIN_MSG -o 1>
     <BUILDPROJECT, FreeRTOS_MIN_MSG, Release>
      # I don't trust the headless builder to finish correctly before this process continues.
     <SLEEP, 3>
     <ASSERT_FILEEXISTS, FreeRTOS_MIN_MSG/Release/FreeRTOS_MIN_MSG.dxe>
     <CMD, python ../CCESSpace.py -d FreeRTOS_MIN_MSG -p PROCESSOR_TEMPLATE  -t MSG -n 1>
     <CMD, python ../CCESSpace.py  -d FreeRTOS_MIN_MSG -o 2>
     <BUILDPROJECT, FreeRTOS_MIN_MSG, Release>
      # I don't trust the headless builder to finish correctly before this process continues.
     <SLEEP, 3>
     <ASSERT_FILEEXISTS, FreeRTOS_MIN_MSG/Release/FreeRTOS_MIN_MSG.dxe>
     <CMD, python ../CCESSpace.py -d FreeRTOS_MIN_MSG -p PROCESSOR_TEMPLATE  -t MSG -n 2>

     #Flags
     <CMD, python ../CCESSpace.py  -d FreeRTOS_MIN_FLG -o 1>
     <BUILDPROJECT, FreeRTOS_MIN_FLG, Release>
      # I don't trust the headless builder to finish correctly before this process continues.
